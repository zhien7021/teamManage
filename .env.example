# ==============================================================================
# FRC 10114 隊務管理系統 - Vercel 環境變數設定範例 (.env.example)
# 請於 Vercel 專案後台 (Settings -> Environment Variables) 設定以下變數
# ==============================================================================

# 1. Google 試算表與 Apps Script 後端代理設定 (用於 /api/submit-sheet)
# 移轉至後端環境變數後，前端 F12 將不再暴露試算表 ID 與 Webhook 網址
GOOGLE_SPREADSHEET_ID="請填入您的_Google_試算表_ID"
GAS_WEBHOOK_URL="https://script.google.com/macros/s/請填入您的_Apps_Script_部署ID/exec"

# (選填) Google Apps Script 請求來源驗證密鑰，用於驗證 POST 請求確由本系統後端發起
GAS_WEBHOOK_SECRET="請自訂一組高強度隨機密鑰字串"

# 2. Firebase 雲端資料庫連線設定
# 提醒：請務必於 Google Cloud Console -> APIs & Services -> Credentials
# 為此 API Key 設定「HTTP 參照網址 (網站) 白名單」，僅允許您的 Vercel 網域呼叫
FIREBASE_API_KEY="請填入您的_Firebase_Web_API_Key"
FIREBASE_AUTH_DOMAIN="frc10114-team-manage.firebaseapp.com"
FIREBASE_PROJECT_ID="frc10114-team-manage"
FIREBASE_STORAGE_BUCKET="frc10114-team-manage.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="204976301369"
FIREBASE_APP_ID="1:204976301369:web:86d7cdd1d7d273647974e8"
